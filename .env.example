# The application reads environment variables, not this file automatically.
VESSEL_SOURCE=demo
AISSTREAM_API_KEY=
# Background public-data crawler (Wikidata), independent of AISStream credentials.
VESSEL_ENRICHMENT_ENABLED=true
# Optional JSON geographic bounds: [[[south, west], [north, east]]]
# Região aproximada do Brasil e águas próximas: sudoeste, nordeste (latitude, longitude).
AISSTREAM_BOUNDING_BOXES=[[[-40,-80],[10,-25]]]
PORT=8000
MVISION_DATA_DIR=C:\Dev\M_Vision\data
COLLECTION_INTERVAL_SECONDS=300
# Optional worldwide aircraft source. Keep disabled until licensed and configured.
AIRCRAFT_SOURCE=disabled
OPENSKY_LICENSE_CONFIRMED=false
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
